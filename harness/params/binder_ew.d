# binder_ew configuration for the scbinder regression harness.
# The algorithm section must stay in lockstep with the scbinder side
# (harness/binder_sc.d) — same commands, same values.

MyModuleId   MOD_BINDER_EW
RingName     PICK_RING
LogFile      1
HeartbeatInt 30

GetPicksFrom   INST_WILDCARD    MOD_WILDCARD

log_stack
hypcode    7

# Station list generated by sc2ewpick.py
maxsite 2000
@sites_ew.d

# ------- algorithm section (keep identical to binder_sc.d) -------

lay   0.0  5.8
lay  20.0  6.5
lay  40.0  8.0
psratio 1.73

dspace   10.0
grdlat   -41.0  -35.0
grdlon   140.0  147.0
grdz       0.0   40.0
rstack   300.0
tstack     0.6
stack    200
thresh    16
focus     20
grid_wt 0 4
grid_wt 1 3
grid_wt 2 2
grid_wt 3 1

rAvg_Factor 5.0
taper     0.0  1.0
taper    50.0  1.0
taper   200.0  2.5
taper   400.0  4.5
taper_OT  2.0  1.0
t_dif    -3.0  240.0

wt 0 1.0
wt 1 0.5
wt 2 0.25
wt 3 0.125
ph P  1.0
ph Pn 0.5
ph Pg 0.5
r_max   400.0
zrange    1.0  40.0
MaxStep  25.0   5.0
MinXYZstep 0.1
MaxIter    4
MaxDeltaRms 1.0001
locate_eq  25   2
locate_eq  50   4
locate_eq  75   8
locate_eq 100  16

rmscut_pick 0.3  20
rmscut_pick 0.5  50
rmscut_pick 1.0 100

assess_pk  6  20
maxtrial   500
maxwt      3
v_halfspace   5.0
residual_cut  3.0  10.0

no_P_on_Horiz
no_S_on_Z
ChannelNumberMap NEZ

nearest_quake_dist 5 2

EventIdFile quake_id.d
